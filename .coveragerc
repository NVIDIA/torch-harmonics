[run]
# record paths relative to the checkout, so data files from different runners and jobs
# combine; the distributed suite runs against the installed wheel, see [paths]
relative_files = True
omit =
    */examples/*
    */plotting.py
    # written by setuptools-scm at build time and gitignored, so a fresh checkout has no
    # source for it to report against
    */_version.py

[paths]
# the distributed jobs measure the wheel in site-packages, the serial job the editable
# source tree; fold both onto the source tree when combining
source =
    torch_harmonics/
    */site-packages/torch_harmonics/

[report]
# Abstract interface methods: a base class says what a subclass must define, and no
# test can reach the raise without a subclass that is broken on purpose. Only these
# two forms -- a bare raise, and the grid base classes' "does not define" -- so that a
# NotImplementedError refusing an unsupported mode or device still has to be tested.
exclude_also =
    ^\s*raise NotImplementedError$
    raise NotImplementedError\(f"\{(type\(self\)|cls)\.__name__\} does not define
